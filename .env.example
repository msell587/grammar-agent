# Copy to .env and fill in. Never commit .env.

# Which backend to use: gemini | groq | ollama | mock
GRAMMAR_AGENT_PROVIDER=gemini

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative: Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local: Ollama (https://ollama.com), no key needed
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Seconds to wait between uncached requests (keeps you under free-tier RPM)
GRAMMAR_AGENT_REQUEST_DELAY=6.5
